@{
    ViewData["Title"] = "Reset Password";
    var email = ViewBag.Email as string;
    var token = ViewBag.Token as string;
}

<div class="container mt-5" style="max-width: 450px;">
    <div class="card border-0 shadow-sm rounded-4 p-4">
        <h3 class="fw-bold mb-3 text-center">Set New Password</h3>

        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="email" value="@email" />
            <input type="hidden" name="token" value="@token" />

            <div class="mb-3">
                <label class="form-label small fw-semibold">New Password</label>
                <input type="password" name="newPassword" class="form-control rounded-pill" placeholder="••••••••" required />
            </div>
            <div class="mb-3">
                <label class="form-label small fw-semibold">Confirm Password</label>
                <input type="password" name="confirmPassword" class="form-control rounded-pill" placeholder="••••••••" required />
            </div>
            <button type="submit" class="w-100 btn btn-primary rounded-pill py-2" style="background-color: #0B735F; border: none;">
                Update Password
            </button>
        </form>
    </div>
</div>