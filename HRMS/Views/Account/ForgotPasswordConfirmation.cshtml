@{
    ViewData["Title"] = "Email Sent";
}

<div class="container mt-5" style="max-width: 450px;">
    <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
        <div class="mb-3 text-success fs-1">
            <i class="fa-solid fa-circle-check"></i>
        </div>
        <h3 class="fw-bold mb-2">Password Reset Request</h3>
        <p class="text-muted small mb-4">Check the top-right toast notification for your direct reset link generated for this session.</p>
        <a asp-action="Login" class="btn btn-primary rounded-pill px-4" style="background-color: #0B735F; border: none;">Return to Login</a>
    </div>
</div>