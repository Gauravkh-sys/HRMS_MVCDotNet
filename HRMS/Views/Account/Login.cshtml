@model HRMS.Web.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Sign In";
    Layout = null; // Independent full-screen layout
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In - Enterprise HRMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style type="text/css">
            :root {
                --hr-primary: #384166;
                --hr-secondary: #0B735F;
                --hr-accent: #0CDC2A;
                --hr-sage: #639D75;
                --hr-light-bg: #F8F9FA;
            }

            body, html {
                height: 100%;
                margin: 0;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            .split-container {
                display: flex;
                height: 100vh;
                width: 100vw;
                overflow: hidden;
            }

            /* Left Form Pane */
            .login-form-pane {
                flex: 1;
                display: flex;
                align-items: center;
                justify-content: center;
                background-color: #ffffff;
                padding: 2rem;
                overflow-y: auto;
            }

            .login-form-wrapper {
                width: 100%;
                max-width: 420px;
            }

            /* Right Hero / Branding Pane */
            .login-hero-pane {
                flex: 1;
                background: linear-gradient(135deg, var(--hr-secondary), var(--hr-primary));
                color: white;
                display: flex;
                flex-direction: column;
                justify-content: center;
                padding: 4rem;
                position: relative;
                overflow: hidden;
            }

                .login-hero-pane::before {
                    content: '';
                    position: absolute;
                    width: 200%;
                    height: 200%;
                    background: radial-gradient(circle, rgba(12, 221, 42, 0.1) 0%, transparent 60%);
                    top: -50%;
                    left: -50%;
                }

            /* Custom Input Pill Styling */
            .form-control-pill {
                border-radius: 50rem;
                padding: 0.75rem 1.25rem;
                border: 1px solid #ced4da;
                background-color: #fcfcfc;
            }

                .form-control-pill:focus {
                    border-color: var(--hr-secondary);
                    box-shadow: 0 0 0 0.2rem rgba(11, 115, 95, 0.15);
                }

            /* Custom Dark Pill Button */
            .btn-pill-dark {
                border-radius: 50rem;
                padding: 0.75rem;
                background-color: #1a1a1a;
                color: white;
                border: none;
                font-weight: 600;
                transition: background-color 0.2s;
            }

                .btn-pill-dark:hover {
                    background-color: var(--hr-primary);
                    color: white;
                }

            .btn-pill-light {
                border-radius: 50rem;
                padding: 0.75rem;
                background-color: #ffffff;
                color: #333333;
                border: 1px solid #dcdcdc;
                font-weight: 500;
                transition: background-color 0.2s;
            }

                .btn-pill-light:hover {
                    background-color: #f1f1f1;
                }

            .brand-icon-box {
                width: 50px;
                height: 50px;
                background-color: var(--hr-accent);
                color: #111;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 14px;
                font-size: 1.5rem;
                margin-bottom: 1.5rem;
                box-shadow: 0 4px 12px rgba(12, 221, 42, 0.3);
            }
    </style>
</head>
<body>
    <div class="split-container">
        <!-- Left Pane: Modern Login Form -->
        <div class="login-form-pane">
            <div class="login-form-wrapper">
                <div class="brand-icon-box">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <h2 class="fw-bold mb-1">Sign in to your account</h2>
                <p class="text-muted mb-4">Enter your email or connect your account to sign in.</p>

                <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold small">Email</label>
                        <input asp-for="Email" class="form-control form-control-pill" placeholder="name@company.com" autocomplete="username" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold small">Password</label>
                        <input asp-for="Password" class="form-control form-control-pill" placeholder="••••••••••••" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        @* <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label small text-secondary"></label>
                        </div> *@
                        <div class="mb-3 text-end">
                            <a asp-controller="Account" asp-action="ForgotPassword" class="text-decoration-none small text-muted">Forgot Password?</a>
                        </div>
                        @* <a href="#" class="small text-decoration-none text-secondary fw-semibold">Forgot password?</a> *@
                    </div>

                    <button type="submit" class="btn btn-pill-dark w-100 mb-4 shadow-sm">
                        Sign in <i class="fa-solid fa-arrow-right ms-2"></i>
                    </button>

                   @*  <div class="text-center position-relative mb-4">
                        <hr class="text-muted opacity-25" />
                        <span class="position-absolute top-50 start-50 translate-middle px-3 bg-white text-muted small">or continue with</span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-pill-light">
                            <i class="fa-brands fa-google me-2"></i> Sign in with Google
                        </button>
                        <button type="button" class="btn btn-pill-light">
                            <i class="fa-brands fa-facebook me-2 text-primary"></i> Sign in with Facebook
                        </button>
                    </div> *@
                </form>
            </div>
        </div>

        <!-- Right Pane: Enterprise Brand & Feature Showcase -->
        <div class="login-hero-pane">
            <div style="z-index: 2; max-width: 500px;">
                <span class="badge bg-success bg-opacity-25 text-white px-3 py-2 rounded-pill mb-3 border border-success">
                    <i class="fa-solid fa-circle-dot text-success me-1"></i> Enterprise HRMS Platform
                </span>
                <h1 class="display-6 fw-bold mb-3">Manage workforce, attendance & payroll with confidence.</h1>
                <p class="lead text-white-50 fs-6">Streamline employee lifecycle, track real-time attendance, approve leave requests, and generate instant payslips from a single centralized workspace.</p>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>