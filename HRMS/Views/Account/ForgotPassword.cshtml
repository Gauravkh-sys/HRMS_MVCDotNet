@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container mt-5" style="max-width: 450px;">
    <div class="card border-0 shadow-sm rounded-4 p-4">
        <h3 class="fw-bold mb-3 text-center">Forgot Password</h3>
        <p class="text-muted small text-center mb-4">Enter your email and we'll generate a custom reset link for your account.</p>

        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label small fw-semibold">Email Address</label>
                <input type="email" name="email" class="form-control rounded-pill" placeholder="name@company.com" required />
            </div>
            <button type="submit" class="w-100 btn btn-primary rounded-pill py-2" style="background-color: #0B735F; border: none;">
                Send Reset Link
            </button>
        </form>
        <div class="text-center mt-3">
            <a asp-action="Login" class="text-decoration-none small text-muted">Back to Login</a>
        </div>
    </div>
</div>