@model IEnumerable<HRMS.Domain.Entities.PaySlip>

@{
    ViewData["Title"] = "My Payslips";
    var employeeId = ViewBag.EmployeeId as Guid?;
    int currentYear = DateTime.Now.Year;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">My Payslips & Tax</h2>
            <p class="text-muted small">Access your monthly salary statements, view breakdown, or export securely.</p>
        </div>
        @if (employeeId.HasValue && employeeId.Value != Guid.Empty)
        {
            <a asp-action="DownloadYearlyZip" asp-route-employeeId="@employeeId.Value" asp-route-year="@currentYear" class="btn btn-primary rounded-pill px-4 shadow-sm" style="background-color: #0B735F; border: none;">
                <i class="fa-solid fa-file-zipper me-1"></i> Download @currentYear Archive (ZIP)
            </a>
        }
    </div>

    <!-- Employee Payslips Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Pay Period</th>
                        <th>Basic Salary</th>
                        <th>Allowances</th>
                        <th>Deductions</th>
                        <th>Net Salary</th>
                        <th>Generated On</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">
                                    <i class="fa-solid fa-calendar-days text-muted me-2"></i>
                                    @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(p.Month) @p.Year
                                </td>
                                <td>₹@p.BasicSalary.ToString("N2")</td>
                                <td class="text-success">+₹@p.Allowances.ToString("N2")</td>
                                <td class="text-danger">-₹@p.Deductions.ToString("N2")</td>
                                <td class="fw-bold text-dark">₹@p.NetSalary.ToString("N2")</td>
                                <td class="text-muted small">@p.GeneratedDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <!-- View Button -->
                                        <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            <i class="fa-solid fa-eye me-1"></i> View
                                        </a>

                                        <!-- Export Dropdown Button -->
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle rounded-pill px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="fa-solid fa-download me-1"></i> Export
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                                                <li>
                                                    <a class="dropdown-item py-2" asp-action="DownloadExcel" asp-route-id="@p.Id">
                                                        <i class="fa-solid fa-file-excel text-success me-2"></i> Excel (Read-Only)
                                                    </a>
                                                </li>
                                                <li>
                                                    <a asp-action="Print" asp-route-id="@p.Id" target="_blank" class="dropdown-item py-2">
                                                        <i class="fa-solid fa-file-pdf text-danger me-2"></i> PDF Document
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No payslips available for your account yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>