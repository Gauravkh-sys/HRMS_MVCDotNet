@model IEnumerable<HRMS.Domain.Entities.PaySlip>

@{
    ViewData["Title"] = "Payroll Administration";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Payroll & Salary Slips</h2>
            <p class="text-muted small">Perform bulk salary slip generation and manage organization compensation.</p>
        </div>
        <!-- Bulk Generation Trigger Button -->
        <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#bulkGenerateModal" style="background-color: #0B735F; border: none;">
            <i class="fa-solid fa-calculator me-1"></i> Generate Bulk Slips
        </button>
    </div>

    <!-- Bulk Generation Modal -->
    <div class="modal fade" id="bulkGenerateModal" tabindex="-1" aria-labelledby="bulkGenerateModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <form asp-action="GenerateBulk" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold" id="bulkGenerateModalLabel">Bulk Payslip Generation</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body py-4">
                        <div class="mb-3">
                            <label for="month" class="form-label fw-semibold">Select Month</label>
                            <select name="month" class="form-select rounded-pill">
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <option value="@i" selected="@(i == DateTime.Now.Month)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="year" class="form-label fw-semibold">Select Year</label>
                            <input type="number" name="year" class="form-control rounded-pill" value="@DateTime.Now.Year" required />
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4" style="background-color: #0B735F; border: none;">Generate Now</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Organization Payslips Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Employee</th>
                        <th>Pay Period</th>
                        <th>Basic</th>
                        <th>Allowances</th>
                        <th>Deductions</th>
                        <th>Net Salary</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">@(p.Employee != null ? $"{p.Employee.FirstName} {p.Employee.LastName}" : "Unknown")</td>
                                <td>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(p.Month) @p.Year</td>
                                <td>₹@p.BasicSalary.ToString("N2")</td>
                                <td class="text-success">+₹@p.Allowances.ToString("N2")</td>
                                <td class="text-danger">-₹@p.Deductions.ToString("N2")</td>
                                <td class="fw-bold text-dark">₹@p.NetSalary.ToString("N2")</td>
                                <td class="text-end pe-4">
                                    <a asp-action="DownloadExcel" asp-route-id="@p.Id" class="btn btn-sm btn-outline-success rounded-pill px-3">
                                        <i class="fa-solid fa-file-excel me-1"></i> Excel
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No payslips generated yet. Use bulk generation above.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>