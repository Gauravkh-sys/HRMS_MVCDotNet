@{
    ViewData["Title"] = "My Workspace";
}

<div class="container-fluid px-0">
    <!-- Hero Greeting Banner -->
    <div class="p-4 p-md-5 mb-4 rounded-4 shadow-sm text-white position-relative overflow-hidden" style="background: linear-gradient(135deg, #384166 0%, #0B735F 100%);">
        <div class="position-relative z-index-2 row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-white bg-opacity-15 text-white px-3 py-1.5 rounded-pill mb-2 small fw-normal border border-white border-opacity-25">
                    Have a wonderful workday ahead
                </span>
                <h1 class="fw-bold display-6 mb-2">Good day, @User.Identity?.Name</h1>
                <p class="text-white-50 mb-0 lead fs-6">Take a breath, check your shifts, and manage your day effortlessly from your personal hub.</p>
            </div>
            <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                <div class="d-inline-block bg-black bg-opacity-25 backdrop-blur px-4 py-3 rounded-4 border border-white border-opacity-10 text-start">
                    <div class="small text-white-50">Shift Timing</div>
                    <div class="fw-bold fs-6 text-white">09:30 AM – 06:30 PM</div>
                    <div class="text-success small mt-0.5">Standard Flexi-Hours</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Grid: Personal Profile + Quick Interactive Cards -->
    <div class="row g-4 mb-4">

        <!-- Human Profile & Hierarchy Card -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold fs-4 shadow-sm" style="width: 60px; height: 60px; background-color: #0B735F;">
                                <i class="fa-solid fa-user"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0 text-dark">@User.Identity?.Name</h5>
                                <span class="text-muted small">Senior .NET Core Engineer</span>
                            </div>
                        </div>

                        <div class="bg-light p-3 rounded-3 mb-3 border-start border-4 border-success">
                            <div class="small text-muted mb-1">Employee ID</div>
                            <div class="fw-semibold text-dark">EMP-1042 &bull; Engineering (.NET / Angular)</div>
                        </div>

                        <h6 class="fw-bold small text-uppercase text-secondary mb-2 tracking-wider">
                            Reporting & Support
                        </h6>
                        <div class="p-3 border rounded-3 bg-white mb-2">
                            <div class="small text-muted">Reporting Manager</div>
                            <div class="fw-semibold text-dark d-flex align-items-center justify-content-between">
                                <span>Rajesh Sharma</span>
                                <span class="badge bg-light text-secondary border">Director</span>
                            </div>
                        </div>
                    </div>

                    <div class="text-center mt-3">
                        <!-- Trigger Button for Full Profile Modal -->
                        <button type="button" class="btn btn-outline-dark btn-sm rounded-pill w-100 py-2" data-bs-toggle="modal" data-bs-target="#fullProfileModal">
                            View Full Personal Profile
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Self-Service Action Cards (Attendance, Leaves, Payroll) -->
        <div class="col-lg-8">
            <div class="row g-4 h-100">
                <!-- Attendance Widget -->
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-top border-4 border-success">
                        <div class="card-body p-4 d-flex flex-column justify-content-between text-center">
                            <div>
                                <div class="text-success mb-2 fs-2"><i class="fa-solid fa-fingerprint"></i></div>
                                <h5 class="fw-bold text-dark fs-6">Attendance</h5>
                                <p class="text-muted small">Log your daily check-in or review timesheets.</p>
                            </div>
                            <button class="btn btn-dark rounded-pill btn-sm w-100 py-2 shadow-sm">
                                Punch In / Out
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Leave Management Widget -->
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-top border-4" style="border-color: #0B735F !important;">
                        <div class="card-body p-4 d-flex flex-column justify-content-between text-center">
                            <div>
                                <div class="mb-2 fs-2" style="color: #0B735F;"><i class="fa-solid fa-umbrella-beach"></i></div>
                                <h5 class="fw-bold text-dark fs-6">Leave Balance</h5>
                                <div class="d-flex justify-content-around bg-light py-2 rounded-3 my-2 text-dark small">
                                    <div>Casual: <strong>8d</strong></div>
                                    <div class="vr"></div>
                                    <div>Earned: <strong>12d</strong></div>
                                </div>
                            </div>
                            <a asp-controller="Leaves" asp-action="Index" class="btn btn-outline-dark rounded-pill btn-sm w-100 py-2">
                                Apply or Track Leave
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Payroll Widget -->
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-top border-4 border-warning">
                        <div class="card-body p-4 d-flex flex-column justify-content-between text-center">
                            <div>
                                <div class="text-warning mb-2 fs-2"><i class="fa-solid fa-file-invoice-dollar"></i></div>
                                <h5 class="fw-bold text-dark fs-6">Payslips & Tax</h5>
                                <p class="text-muted small">Access monthly salary logs and tax statements.</p>
                            </div>
                            <a asp-controller="Payroll" asp-action="Index" class="btn btn-outline-dark rounded-pill btn-sm w-100 py-2">
                                Download Slips
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Secondary Row: Performance Goals & Warm Community Feed -->
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="fw-bold mb-0 text-dark">Performance & Goals (OKRs / KPIs)</h5>
                    <span class="badge bg-light text-secondary border">Q4 2026 Cycle</span>
                </div>
                <div class="list-group list-group-flush">
                    <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center border-bottom">
                        <div>
                            <h6 class="mb-1 fw-semibold text-dark">Microservices Architecture Refactoring Phase 1</h6>
                            <small class="text-muted">Target Due: Nov 30, 2026 • Assigned by Rajesh Sharma</small>
                        </div>
                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2">In Progress (75%)</span>
                    </div>
                    <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center border-0">
                        <div>
                            <h6 class="mb-1 fw-semibold text-dark">Annual Security Compliance & Data Privacy Certification</h6>
                            <small class="text-muted">Target Due: Dec 15, 2026</small>
                        </div>
                        <span class="badge bg-success rounded-pill px-3 py-2">Completed</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 border-start border-4 border-primary">
                <h5 class="fw-bold mb-3 text-dark">Team & Culture Feed</h5>
                <div class="d-flex flex-column gap-3">
                    <div class="p-3 bg-light rounded-3">
                        <div class="small text-muted fw-semibold mb-1">Birthday Celebration</div>
                        <p class="mb-0 small text-dark">Wish Priya Sharma (HR Team) a very happy birthday today.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- FULL PERSONAL PROFILE MODAL                -->
<!-- ========================================== -->
<div class="modal fade" id="fullProfileModal" tabindex="-1" aria-labelledby="fullProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header bg-light border-0 px-4 py-3">
                <h5 class="modal-title fw-bold text-dark" id="fullProfileModalLabel">Employee Personnel Profile</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 py-4">

                <!-- Section 1: Core Identification & Demographics -->
                <h6 class="text-uppercase text-secondary fw-bold small mb-3 tracking-wider">Basic Demographics & Contact</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3">
                            <span class="small text-muted d-block">Full Name</span>
                            <span class="fw-semibold text-dark">@User.Identity?.Name</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3">
                            <span class="small text-muted d-block">Employee ID</span>
                            <span class="fw-semibold text-dark">EMP-1042</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3">
                            <span class="small text-muted d-block">Mobile Number</span>
                            <span class="fw-semibold text-dark">+91 98765 43210</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3">
                            <span class="small text-muted d-block">Gender</span>
                            <span class="fw-semibold text-dark">Male</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3">
                            <span class="small text-muted d-block">Date of Birth</span>
                            <span class="fw-semibold text-dark">14 August 1996</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3">
                            <span class="small text-muted d-block">Emergency Contact</span>
                            <span class="fw-semibold text-dark">+91 91234 56789 (Spouse)</span>
                        </div>
                    </div>
                </div>

                <!-- Section 2: Addresses -->
                <h6 class="text-uppercase text-secondary fw-bold small mb-3 tracking-wider">Address Details</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 h-100">
                            <span class="small text-muted d-block fw-semibold mb-1">Communication Address</span>
                            <span class="text-dark small">House No. 142, Golghar Near LIC Building, Gorakhpur, Uttar Pradesh - 273001</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 h-100">
                            <span class="small text-muted d-block fw-semibold mb-1">Permanent Address</span>
                            <span class="text-dark small">Village Hardi, PO Sahjanwa, Gorakhpur, Uttar Pradesh - 273209</span>
                        </div>
                    </div>
                </div>

                <!-- Section 3: Role & Experience -->
                <h6 class="text-uppercase text-secondary fw-bold small mb-3 tracking-wider">Employment & Experience</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3">
                            <span class="small text-muted d-block">Assigned Role</span>
                            <span class="fw-semibold text-dark">Senior .NET Core Engineer</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3">
                            <span class="small text-muted d-block">Total Experience</span>
                            <span class="fw-semibold text-dark">6 Years (3 Years at Enterprise HRMS)</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3">
                            <span class="small text-muted d-block">Department</span>
                            <span class="fw-semibold text-dark">Engineering (.NET / Angular)</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3">
                            <span class="small text-muted d-block">Employment Type</span>
                            <span class="fw-semibold text-dark">Full-Time Permanent</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3">
                            <span class="small text-muted d-block">Official Email</span>
                            <span class="fw-semibold text-dark">@User.Identity?.Name</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3">
                            <span class="small text-muted d-block">Work Location</span>
                            <span class="fw-semibold text-dark">Noida / Remote Hub</span>
                        </div>
                    </div>
                </div>

                <!-- Section 4: Service History & Timeline -->
                <h6 class="text-uppercase text-secondary fw-bold small mb-3 tracking-wider">Service History & Milestones</h6>
                <div class="timeline border-start border-2 ps-3 ms-2">
                    <div class="mb-3 position-relative">
                        <div class="fw-semibold text-dark">Promoted to Senior .NET Core Engineer</div>
                        <div class="small text-muted">October 2024 – Present • Engineering Department</div>
                    </div>
                    <div class="mb-3 position-relative">
                        <div class="fw-semibold text-dark">Joined Enterprise HRMS as Software Engineer</div>
                        <div class="small text-muted">June 2023 – September 2024 • Core Platform Team</div>
                    </div>
                </div>

            </div>
            <div class="modal-footer bg-light border-0 px-4 py-3">
                <button type="button" class="btn btn-secondary rounded-pill px-4 btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>